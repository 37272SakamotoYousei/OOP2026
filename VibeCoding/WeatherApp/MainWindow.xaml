<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather App"
        Height="1000" Width="1100"
        MinHeight="750" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#101827"/>
        <SolidColorBrush x:Key="Surface" Color="#1D2B42"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedText" Color="#B7C8E8"/>
        <SolidColorBrush x:Key="Accent" Color="#438BFF"/>
        <SolidColorBrush x:Key="HeroBackground" Color="#1D3557"/>
        <SolidColorBrush x:Key="SoftBackground" Color="#17243A"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="WEATHER"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>

                    <TextBlock Text="毎日の天気を、もっと分かりやすく。"
                               FontSize="14"
                               Foreground="{DynamicResource MutedText}"/>
                </StackPanel>

                <Button x:Name="ThemeButton"
                        Grid.Column="1"
                        Content="🌙 ダークモード"
                        Width="155"
                        Height="42"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- 地域選択・検索 -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>

                    <TextBlock Text="地域を選択"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="都道府県"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="PrefectureComboBox"
                              Margin="0,0,0,16"/>

                    <TextBlock Text="市区町村名で検索"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CitySearchTextBox"
                                 Margin="0,0,10,0"/>

                        <Button x:Name="SearchButton"
                                Grid.Column="1"
                                Content="検索"
                                Width="100"
                                Height="42"/>
                    </Grid>

                    <TextBlock Text="検索結果・地域一覧"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="CityComboBox"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,18"/>

                    <TextBlock Text="お気に入りの地域"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="FavoriteComboBox"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,8,0"/>

                        <Button x:Name="AddFavoriteButton"
                                Grid.Column="1"
                                Content="☆ 登録"
                                Height="42"
                                Margin="0,0,8,0"/>

                        <Button x:Name="RemoveFavoriteButton"
                                Grid.Column="2"
                                Content="削除"
                                Height="42"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 現在の天気 -->
            <Border x:Name="CurrentWeatherCard"
                    Grid.Row="2"
                    Background="{DynamicResource HeroBackground}"
                    CornerRadius="22"
                    Padding="28"
                    Margin="0,0,0,22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CityNameText"
                                   Text="東京の天気"
                                   FontSize="25"
                                   FontWeight="Bold"/>

                        <TextBlock Text="現在の天気"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedText}"
                                   Margin="0,12,0,5"/>

                        <TextBlock x:Name="WeatherText"
                                   Text="天気情報を取得中..."
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TemperatureText"
                                   Text="-- ℃"
                                   FontSize="58"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"/>

                        <Button x:Name="RefreshButton"
                                Content="↻ 天気を更新"
                                Width="160"
                                Height="42"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <Border Background="{DynamicResource Surface}"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="湿度"
                                           Foreground="{DynamicResource MutedText}"/>

                                <TextBlock x:Name="HumidityText"
                                           Text="-- %"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Surface}"
                                CornerRadius="14"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="風速"
                                           Foreground="{DynamicResource MutedText}"/>

                                <TextBlock x:Name="WindSpeedText"
                                           Text="-- m/s"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 24時間予報 -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="24時間の天気予報"
                           Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource Card}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HourlyForecastPanel"
                                    Orientation="Horizontal"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 気温グラフ -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="7日間の気温グラフ"
                           Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="最高気温・最低気温"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedText}"
                                   Margin="0,0,0,15"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="TemperatureChart"
                                    Width="820"
                                    Height="250"
                                    Background="{DynamicResource Surface}"
                                    ClipToBounds="True"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 7日間予報 -->
            <StackPanel Grid.Row="5">
                <TextBlock Text="7日間の天気予報"
                           Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="ForecastPanel"/>
                </Border>
            </StackPanel>

            <!-- フッター -->
            <StackPanel Grid.Row="6"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,20">

                <TextBlock Text="WEATHER APP"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedText}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Weather data provided by Open-Meteo"
                           FontSize="11"
                           Foreground="{DynamicResource MutedText}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
